class Solution {
public:
    bool isPerfect(int n) {
        if (n <= 1) return false;
        int sum = 0;
        for (int i = 1; i * i <= n; i++) {
            if (n % i == 0) {
                sum += i;
                if (i!=1 &&(n/i)!=i) {
                    sum += n / i;
                }
            }
        }
        return sum == n;
    }
};
