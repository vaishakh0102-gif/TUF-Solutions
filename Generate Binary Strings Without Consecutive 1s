class Solution {
private:
    void printF(int ind, string &ds,int n,vector<string>&ans){
        if (ind==n){
            ans.push_back(ds);
            return;
        }
        ds.push_back('0');
        printF(ind+1,ds,n,ans);
        ds.pop_back();
        if(ds.empty() || ds.back()!='1'){
            ds.push_back('1');
            printF(ind+1,ds,n,ans);
            ds.pop_back();
        }
    }
public:
    vector<string> generateBinaryStrings(int n) {
        
        
        vector<string>ans;
        if (n<=0)return ans;
        string ds="";
        printF(0,ds,n,ans);
        return ans;
    }
};
